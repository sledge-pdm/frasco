{
  "name": "@sledge-pdm/frasco",
  "version": "0.2.9",
  "description": "WebGL Texture processing package for sledge",
  "author": "innsbluck",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json && pnpm exec tsc-alias -p tsconfig.build.json",
    "test": "vitest run --browser",
    "test:ui": "vitest --browser",
    "dev": "vite",
    "dev:build": "vite build",
    "preview": "vite preview",
    "tsc": "pnpm exec tsc --noEmit --skipLibCheck",
    "prettier": "prettier --write . --config .prettierrc",
    "format": "pnpm prettier",
    "lint-staged": "lint-staged",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "dependencies": {
    "@sledge-pdm/core": "^1.2.7"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@sledge-pdm/ui": "^1.2.10",
    "@types/node": "^26.6.3",
    "@vitest/browser-playwright": "^4.1.10",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.14.0",
    "solid-js": "^1.9.15",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/"
  }
}
